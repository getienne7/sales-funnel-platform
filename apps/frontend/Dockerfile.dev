FROM node:18-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
COPY apps/frontend/package*.json ./apps/frontend/
RUN npm ci

# Copy source code
COPY apps/frontend ./apps/frontend
COPY turbo.json ./

# Expose port
EXPOSE 3000

# Start development server
WORKDIR /app/apps/frontend
CMD ["npm", "run", "dev"]

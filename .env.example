# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypto_funnel_dev"
REDIS_URL="redis://localhost:6379"
ELASTICSEARCH_URL="http://localhost:9200"

# JWT and Security
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
ENCRYPTION_KEY="your-32-character-encryption-key-here"

# Server Configuration
NODE_ENV="development"
PORT="4000"
HOST="0.0.0.0"
LOG_LEVEL="info"

# Frontend Configuration
FRONTEND_URL="http://localhost:3000"
API_HOST="localhost:4000"

# Web3 Configuration
NEXT_PUBLIC_WEB3_PROJECT_ID="your-walletconnect-project-id"
ALCHEMY_API_KEY="your-alchemy-api-key"
INFURA_PROJECT_ID="your-infura-project-id"
MORALIS_API_KEY="your-moralis-api-key"

# Blockchain RPC URLs
ETHEREUM_RPC_URL="https://eth-mainnet.alchemyapi.io/v2/your-api-key"
POLYGON_RPC_URL="https://polygon-mainnet.alchemyapi.io/v2/your-api-key"
BSC_RPC_URL="https://bsc-dataseed.binance.org/"
ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"

# Email Configuration
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your-sendgrid-api-key"
FROM_EMAIL="noreply@cryptofunnel.io"

# AWS Configuration (for S3 file storage)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="crypto-funnel-assets"

# Stripe Configuration (for traditional payments)
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# KYC/AML Provider Configuration
JUMIO_API_TOKEN="your-jumio-api-token"
JUMIO_API_SECRET="your-jumio-api-secret"
CHAINALYSIS_API_KEY="your-chainalysis-api-key"

# Analytics and Monitoring
DATADOG_API_KEY="your-datadog-api-key"
SENTRY_DSN="your-sentry-dsn"

# Rate Limiting
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="60000"

# File Upload Limits
MAX_FILE_SIZE="10485760"  # 10MB in bytes

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,https://app.cryptofunnel.io"

# Session Configuration
SESSION_SECRET="your-session-secret-key"
SESSION_MAX_AGE="86400000"  # 24 hours in milliseconds

# Webhook Configuration
WEBHOOK_SECRET="your-webhook-secret-for-external-services"

# Development/Testing
SKIP_EMAIL_VERIFICATION="false"
MOCK_BLOCKCHAIN_CALLS="false"
